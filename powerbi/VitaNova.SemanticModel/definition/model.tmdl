annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimProduct
ref table DimMarket
ref table DimChannel
ref table DimScenario
ref table FactSales
ref table FactBudget
ref table FactForecast
ref table _Measures

