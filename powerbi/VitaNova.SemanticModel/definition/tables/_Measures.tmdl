		formatString: 0.0%
		lineageTag: 0414b56d-91fe-56c5-871a-01ce30720b25

	measure 'Reporting Units YTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([Units],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),1,1)&&DimDate[Date]<=d))
		formatString: #,0
		lineageTag: 342ed3d7-b9a4-5226-8b3d-8973e47f1fa8

	measure 'Reporting Sales MTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([Net Sales],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),MONTH(d),1)&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: 27a8d8bc-6063-5c53-85b2-026e35d1118f

	measure 'Reporting Budget MTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([Sales Budget],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),MONTH(d),1)&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: 997d869b-d660-5a8f-8f1a-b69600a7791b

	measure 'Reporting MTD Attainment %' = DIVIDE([Reporting Sales MTD],[Reporting Budget MTD])
		formatString: 0.0%
		lineageTag: 9cf42281-d970-52b8-89dc-162c906c76df

	measure 'Reporting Sales QTD' = VAR d=[Reporting Cutoff] VAR qstart=DATE(YEAR(d),MONTH(d)-MOD(MONTH(d)-1,3),1) RETURN CALCULATE([Net Sales],FILTER(ALL(DimDate),DimDate[Date]>=qstart&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: e3e34cde-d042-59cf-9114-3589c807fc09

	measure 'Reporting Budget QTD' = VAR d=[Reporting Cutoff] VAR qstart=DATE(YEAR(d),MONTH(d)-MOD(MONTH(d)-1,3),1) RETURN CALCULATE([Sales Budget],FILTER(ALL(DimDate),DimDate[Date]>=qstart&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: f739b350-ce79-556c-bdf9-e0bde6eabb18

	measure 'Reporting QTD Attainment %' = DIVIDE([Reporting Sales QTD],[Reporting Budget QTD])
		formatString: 0.0%
		lineageTag: 01733144-1f24-5485-a703-c5bcb1307bfe

	measure 'Monthly Sales Report Year' = VAR y=[Reporting Year] RETURN CALCULATE([Net Sales],KEEPFILTERS(DimDate[Year]=y))
		formatString: €#,0;€-#,0
		lineageTag: 6f5af4b5-1158-57b3-8004-8d2d89f5b293

	measure 'Monthly Budget Report Year' = VAR y=[Reporting Year] RETURN CALCULATE([Sales Budget],KEEPFILTERS(DimDate[Year]=y))
		formatString: €#,0;€-#,0
		lineageTag: 90a399a1-0635-5bf8-8237-fd9fa03302af

	measure 'FY2026 Budget' = CALCULATE([Sales Budget],REMOVEFILTERS(DimDate),DimDate[Year]=2026)
		formatString: €#,0;€-#,0
		lineageTag: 4a3595a9-bc7a-51f6-9a64-fec45ae3b0df

	measure 'FY2026 Actual Through Close' = CALCULATE([Net Sales],REMOVEFILTERS(DimDate),DimDate[Date]>=DATE(2026,1,1),DimDate[Date]<=DATE(2026,9,30))
		formatString: €#,0;€-#,0
		lineageTag: bf81ccbe-f0bc-5c3b-8818-bb2e344f8381

	measure 'FY2026 COGS Through Close' = CALCULATE([COGS],REMOVEFILTERS(DimDate),DimDate[Date]>=DATE(2026,1,1),DimDate[Date]<=DATE(2026,9,30))
		formatString: €#,0;€-#,0
		lineageTag: eda5568a-bbf8-5ef7-a6ff-c52814fb393a

	measure 'Remaining Forecast' = CALCULATE(SUM(FactForecast[ForecastSalesEUR]),REMOVEFILTERS(DimDate),DimDate[Year]=2026,FactForecast[ForecastStatus]="Projection")
		formatString: €#,0;€-#,0
		lineageTag: 522f3fea-1dba-5831-baab-d02f6b42245f

	measure 'Remaining Forecast COGS' = CALCULATE(SUM(FactForecast[ForecastCOGSEUR]),REMOVEFILTERS(DimDate),DimDate[Year]=2026,FactForecast[ForecastStatus]="Projection")
		formatString: €#,0;€-#,0
		lineageTag: 880918d8-9f5c-53b2-ab69-2d843f1805a4

	measure 'Scenario Multiplier' = SELECTEDVALUE(DimScenario[Multiplier],1.0)
		formatString: 0.00
		lineageTag: cc25334d-ed94-5e48-9f24-97b9cee4ead3

	measure 'FY2026 Scenario Sales' = [FY2026 Actual Through Close]+[Remaining Forecast]*[Scenario Multiplier]
		formatString: €#,0;€-#,0
		lineageTag: 335e7ffe-186b-55ee-aa37-5c1ea71a34ef

	measure 'FY2026 Scenario COGS' = [FY2026 COGS Through Close]+[Remaining Forecast COGS]*[Scenario Multiplier]
		formatString: €#,0;€-#,0
		lineageTag: c48299aa-0cfd-5c4b-bf67-d18bbbb2a4a0

	measure 'FY2026 Scenario Attainment %' = DIVIDE([FY2026 Scenario Sales],[FY2026 Budget])
		formatString: 0.0%
		lineageTag: 9e8d1787-a6f5-59ec-aa00-540dd64d03e5

	measure 'FY2026 Scenario Margin %' = DIVIDE([FY2026 Scenario Sales]-[FY2026 Scenario COGS],[FY2026 Scenario Sales])
		formatString: 0.0%
		lineageTag: c23528ac-b904-5516-bd5b-66096e4428b5

	measure 'FY2026 Scenario Variance EUR' = [FY2026 Scenario Sales]-[FY2026 Budget]
		formatString: €#,0;€-#,0
		lineageTag: ebd18a76-5d72-5c1d-8eff-42b17c0e47a3

	measure 'Forecast Monthly' = SUM(FactForecast[ForecastSalesEUR])
		formatString: €#,0;€-#,0
		lineageTag: 86bf96f9-ab57-5fcd-a48b-1833c61bdf22

	measure 'Forecast COGS Monthly' = SUM(FactForecast[ForecastCOGSEUR])
		formatString: €#,0;€-#,0
		lineageTag: c4bb181b-4aee-42d2-af73-4d9ae7d12f46

	measure 'Scenario Forecast Monthly' = SUMX(FactForecast,IF(FactForecast[ForecastStatus]="Projection",FactForecast[ForecastSalesEUR]*[Scenario Multiplier],FactForecast[ForecastSalesEUR]))
		formatString: €#,0;€-#,0
		lineageTag: ddff91a3-3071-5a84-aabb-797ce8d46bfc

	measure 'FY2026 Outlook Gap %' = DIVIDE([FY2026 Scenario Sales]-[FY2026 Budget],[FY2026 Budget])
		formatString: 0.0%
		lineageTag: 034b2b49-22f7-5d55-b206-69448878bb0c

	measure 'Reporting Gross Profit YTD' = [Reporting Sales YTD]-[Reporting COGS YTD]
		formatString: €#,##0;€-#,##0
		lineageTag: e9f6f9b9-0d63-54e8-b061-711d4f0569e8

