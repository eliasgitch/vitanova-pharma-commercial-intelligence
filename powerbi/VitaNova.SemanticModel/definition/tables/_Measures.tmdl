	measure 'Sales YTD' = CALCULATE([Net Sales],DATESYTD(DimDate[Date]))
		formatString: €#,0;€-#,0
		lineageTag: 9617c2fa-beed-5d4e-8d98-b3155522a7db

	measure 'Budget YTD' = CALCULATE([Sales Budget],DATESYTD(DimDate[Date]))
