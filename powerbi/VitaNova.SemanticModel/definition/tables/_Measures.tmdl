	measure 'Sales PY' = CALCULATE([Net Sales],SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: €#,0;€-#,0
		lineageTag: 2af6141e-10fb-5e7c-86e7-4f7ca6b1ece6

	measure 'Sales YoY %' = DIVIDE([Net Sales]-[Sales PY],[Sales PY])
