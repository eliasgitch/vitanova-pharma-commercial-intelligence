	measure 'Rolling 12M Sales' = CALCULATE([Net Sales],DATESINPERIOD(DimDate[Date],MAX(DimDate[Date]),-12,MONTH))
		formatString: €#,0;€-#,0
		lineageTag: befc72e4-63a3-5da8-a085-90dc161f0768

	measure 'Reporting Year' = COALESCE(SELECTEDVALUE(DimDate[Year]),2026)
		formatString: 0
		lineageTag: 078c9632-9bc3-5cdd-996b-dc3dd2a08eaa

	measure 'Reporting Cutoff' = VAR yr=[Reporting Year] VAR lastDate=MAX(DimDate[Date]) VAR approvedClose=IF(yr=2026,DATE(2026,9,30),DATE(yr,12,31)) RETURN MIN(lastDate,approvedClose)
		formatString: yyyy-mm-dd
		lineageTag: ad1a4283-01d4-5faa-9ac0-0b193b6ff56d

	measure 'Reporting Sales YTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([Net Sales],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),1,1)&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: 13e5a933-4b7d-5f5e-9d21-0ee6fd2fd03a

	measure 'Reporting Budget YTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([Sales Budget],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),1,1)&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: bf95a07b-5820-591f-bc27-ea9fae53697c

	measure 'Reporting Sales PY' = VAR d=[Reporting Cutoff] VAR first=DATE(YEAR(d)-1,1,1) VAR last=EDATE(d,-12) RETURN CALCULATE([Net Sales],FILTER(ALL(DimDate),DimDate[Date]>=first&&DimDate[Date]<=last))
		formatString: €#,0;€-#,0
		lineageTag: 9c45478e-76eb-55a5-8785-2dddf5822192

	measure 'Reporting Attainment %' = DIVIDE([Reporting Sales YTD],[Reporting Budget YTD])
		formatString: 0.0%
		lineageTag: 97f3f277-c88b-5b2e-9457-430a2de3d57f

	measure 'Reporting Variance EUR' = [Reporting Sales YTD]-[Reporting Budget YTD]
		formatString: €#,0;€-#,0
		lineageTag: a3e595d2-c5d7-5d84-ac92-5c2ac9d2387c

	measure 'Reporting Variance %' = DIVIDE([Reporting Variance EUR],[Reporting Budget YTD])
		formatString: 0.0%
		lineageTag: b889b6d3-896a-5bbd-a9b9-9417635125a5

	measure 'Reporting YoY %' = DIVIDE([Reporting Sales YTD]-[Reporting Sales PY],[Reporting Sales PY])
		formatString: 0.0%
		lineageTag: e0d276fb-f76a-5995-b336-950338231d40

	measure 'Reporting COGS YTD' = VAR d=[Reporting Cutoff] RETURN CALCULATE([COGS],FILTER(ALL(DimDate),DimDate[Date]>=DATE(YEAR(d),1,1)&&DimDate[Date]<=d))
		formatString: €#,0;€-#,0
		lineageTag: d63faffd-d3ad-5b1e-a1a4-77e5f23da49b

